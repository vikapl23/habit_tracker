# General Application Configuration
DEBUG=True
# Required: Django SECRET_KEY (used for both local development and Docker Compose; must not be empty)
SECRET_KEY=replace-with-a-secure-secret-key
ALLOWED_HOSTS=localhost,127.0.0.1,backend
DATABASE_URL=sqlite:///db.sqlite3
AUTH_THROTTLE_RATE=100/minute
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:3000

# Docker Compose Configuration
# Note: Docker Compose reads SECRET_KEY directly from .env (no insecure fallback is hardcoded)
POSTGRES_DB=habit_tracker
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
VITE_API_URL=http://localhost:8000/api/v1
# DATABASE_URL for Docker: postgres://postgres:postgres@db:5432/habit_tracker

# Optional: Automatic Superuser Creation on Container Startup (e.g. Render / Docker)
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=change-me-to-a-secure-password

# Email Notifications via Mailgun (Leave MAILGUN_API_KEY empty for console backend during local dev)
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_API_URL=https://api.mailgun.net/v3
DEFAULT_FROM_EMAIL=Habit Tracker <noreply@example.com>
# Must be the backend URL (used for unsubscribe links)
SITE_URL=http://localhost:8000

# Internal Cron Dispatch Authorization Token
CRON_TOKEN=

# Google Cloud Vertex AI / AI Coach Configuration
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
GEMINI_MODEL=gemini-2.5-flash
# Path to service account JSON (on Render: /etc/secrets/gcp-credentials.json)
GOOGLE_APPLICATION_CREDENTIALS=
COACH_DAILY_MESSAGE_LIMIT=20

