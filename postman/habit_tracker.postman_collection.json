{
  "info": {
    "name": "Habit Tracker API",
    "description": "Колекція для ручного і автоматичного тестування Habit Tracker API.\n\n1. Запусти сервер: python manage.py runserver\n2. Запусти папку 1. Auth (Register, Login) — токен збережеться сам.\n3. Далі будь-які запити, або всю колекцію через Run collection.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{access}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000/api/v1"
    },
    {
      "key": "email",
      "value": "anna@test.com"
    },
    {
      "key": "email_bob",
      "value": "bob@test.com"
    },
    {
      "key": "password",
      "value": "StrongPass123!"
    },
    {
      "key": "access",
      "value": ""
    },
    {
      "key": "refresh",
      "value": ""
    },
    {
      "key": "access_bob",
      "value": ""
    },
    {
      "key": "habit_id",
      "value": ""
    },
    {
      "key": "yesterday",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Auth",
      "description": "Реєстрація і логін. Запусти Register, потім Login — далі всі запити підуть з токеном.",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/register/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "register",
                ""
              ]
            },
            "description": "Створює користувача. Повторний запуск поверне 400 — це нормально, користувач уже є.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"201 Created (or 400 if already registered)\", () => pm.expect(pm.response.code).to.be.oneOf([201, 400]));"
                ]
              }
            }
          ]
        },
        {
          "name": "Login (get tokens)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/token/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "token",
                ""
              ]
            },
            "description": "Логін. Скрипт автоматично зберігає access і refresh у змінні колекції.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "const d = pm.response.json();",
                  "pm.collectionVariables.set(\"access\", d.access);",
                  "pm.collectionVariables.set(\"refresh\", d.refresh);",
                  "pm.test(\"Tokens saved\", () => pm.expect(d.access).to.be.a(\"string\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Refresh token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/token/refresh/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "token",
                "refresh",
                ""
              ]
            },
            "description": "Отримує новий access-токен за refresh-токеном.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh\": \"{{refresh}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set(\"access\", pm.response.json().access);"
                ]
              }
            }
          ]
        }
      ]
    },
