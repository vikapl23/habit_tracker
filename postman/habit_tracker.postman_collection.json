        {
          "name": "Invalid date filter -> 400",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/habits/{{habit_id}}/check-ins/?from=invalid-date",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "habits",
                "{{habit_id}}",
                "check-ins",
                ""
              ],
              "query": [
                {
                  "key": "from",
                  "value": "invalid-date"
                }
              ]
            },
            "description": ""
